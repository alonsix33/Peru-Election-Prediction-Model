# ── Frontend environment variables ──────────────────────────────────
# Copy this file to .env for local development.
# In Cloudflare Pages: set these in Settings → Environment Variables (both Preview and Production).
#
# REQUIRED — without this, all API calls return the SPA HTML and the app
# runs in demo mode all night (including on election night June 7).
VITE_API_URL=https://peru-election-prediction-model-production.up.railway.app
